{
  "name": "provenance-widgets",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web-components": "./dist/web-components/index.js",
    "./web-components/index.js": "./dist/web-components/index.js",
    "./web-components/styles.css": "./dist/web-components/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "peerDependencies": {
    "preact": "^10.29.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@mantine/core": "^8.3.7",
    "d3": "^7.9.0",
    "d3-color": "^3.1.0",
    "primereact": "^10.9.7",
    "react-tooltip": "^5.30.0",
    "tstl": "^3.0.0"
  },
  "scripts": {
    "test": "node --test",
    "build": "npm run build:library && npm run build:web-components",
    "build:library": "tsup",
    "build:web-components": "tsup --config tsup.web-components.config.ts && node scripts/prepare-web-components.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
